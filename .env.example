# Groq API configuration
# Copy this file to .env and replace the placeholder with your Groq API key.
LLM_API_KEY=your_groq_api_key
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-20b

# Optional scaling controls
EMBEDDING_BATCH_SIZE=32
RETRIEVAL_CHUNKS=4

# Other OpenAI-compatible providers can use the same client by changing
# LLM_BASE_URL and LLM_MODEL.
